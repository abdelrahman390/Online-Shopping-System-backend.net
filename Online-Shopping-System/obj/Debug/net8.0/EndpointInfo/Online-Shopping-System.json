          "Payment"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/Payment/creditCardPay": {
      "post": {
        "tags": [
          "Payment"
        ],
        "parameters": [
          {
            "name": "cardNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
